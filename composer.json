{
    "name": "menscircle/typo3-website",
    "description": "Mens Circle Niederbayern - TYPO3 v14.1 Community Website",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Markus Sommer",
            "email": "markus@beardcoder.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "menscircle/sitepackage": "@dev",
        "praetorius/vite-asset-collector": "^1.15",
        "typo3/cms-core": "^14.1",
        "typo3/cms-backend": "^14.1",
        "typo3/cms-frontend": "^14.1",
        "typo3/cms-extbase": "^14.1",
        "typo3/cms-fluid": "^14.1",
        "typo3/cms-fluid-styled-content": "^14.1",
        "typo3/cms-install": "^14.1",
        "typo3/cms-rte-ckeditor": "^14.1",
        "typo3/cms-seo": "^14.1"
    },
    "require-dev": {
        "typo3/coding-standards": "^0.9"
    },
    "repositories": [
        {
            "type": "path",
            "url": "./packages/*"
        }
    ],
    "autoload": {
        "psr-4": {
            "MensCircle\\Sitepackage\\": "packages/sitepackage/Classes/"
        }
    },
    "config": {
        "vendor-dir": "vendor",
        "bin-dir": "vendor/bin",
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "extra": {
        "typo3/cms": {
            "web-dir": "public",
            "app-dir": "."
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "TYPO3\\CMS\\Composer\\Plugin\\Core\\ScriptDispatcher::postAutoloadDump"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
