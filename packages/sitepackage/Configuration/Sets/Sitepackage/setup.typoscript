# Modern TYPO3 v14 page configuration using PAGEVIEW
page = PAGE
page {
    typeNum = 0
    
    10 = PAGEVIEW
    10 {
        paths {
            100 = EXT:sitepackage/Resources/Private/PageView/
        }
        
        dataProcessing {
            # Built-in page-content processor (replaces lib.dynamicContent)
            10 = page-content
            10 {
                as = content
            }
            
            # Menu processor for navigation
            20 = menu
            20 {
                as = mainMenu
                levels = 2
            }
        }
    }
}

# Configuration for content elements (inherited by FLUIDTEMPLATE content elements)
lib.contentElement {
    templateRootPaths {
        10 = EXT:sitepackage/Resources/Private/PageView/Content/
    }
    layoutRootPaths {
        10 = EXT:sitepackage/Resources/Private/PageView/Layouts/
    }
}

# Event List Content Element - using TYPO3's built-in processors
tt_content.sitepackage_eventlist = FLUIDTEMPLATE
tt_content.sitepackage_eventlist {
    templateName = EventList
    templateRootPaths {
        10 = EXT:sitepackage/Resources/Private/PageView/Content/
    }
    layoutRootPaths {
        10 = EXT:sitepackage/Resources/Private/PageView/Layouts/
    }
    
    dataProcessing {
        # Using DatabaseQueryProcessor with proper TYPO3 v14 syntax
        10 = database-query
        10 {
            table = tx_sitepackage_domain_model_event
            orderBy = start_date ASC
            where {
                data = date:U
                wrap = start_date > |
            }
            as = events
        }
    }
}

# Newsletter Form Content Element
tt_content.sitepackage_newsletter = FLUIDTEMPLATE
tt_content.sitepackage_newsletter {
    templateName = NewsletterForm
    templateRootPaths {
        10 = EXT:sitepackage/Resources/Private/PageView/Content/
    }
    layoutRootPaths {
        10 = EXT:sitepackage/Resources/Private/PageView/Layouts/
    }
}

# Testimonials List Content Element - using built-in processor
tt_content.sitepackage_testimonials = FLUIDTEMPLATE
tt_content.sitepackage_testimonials {
    templateName = TestimonialsList
    templateRootPaths {
        10 = EXT:sitepackage/Resources/Private/PageView/Content/
    }
    layoutRootPaths {
        10 = EXT:sitepackage/Resources/Private/PageView/Layouts/
    }
    
    dataProcessing {
        # Using database-query processor (TYPO3 v14 built-in)
        10 = database-query
        10 {
            table = tx_sitepackage_domain_model_testimonial
            where = approved = 1
            orderBy = crdate DESC
            as = testimonials
        }
    }
}

# SEO and meta tags
config {
    doctype = html5
    removeDefaultJS = 0
    admPanel = 1
    debug = 0
    cache_period = 86400
    sendCacheHeaders = 1
    
    # Language settings
    language = de
    locale_all = de_DE.UTF-8
    htmlTag_langKey = de
    
    # Meta tags
    headerComment = Mens Circle Niederbayern
}
